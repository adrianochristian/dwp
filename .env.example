# Configuração local de desenvolvimento; a autenticação é desativada explicitamente.
AUTH_ENABLED=false
PORT=3000

# Credenciais fictícias dos containers locais, sem vínculo com contas externas.
DATABASE_URL=postgresql://dwp:dwp@127.0.0.1:5432/dwp
POSTGRES_PORT=5432
SQS_ENDPOINT=http://127.0.0.1:4566
SQS_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

WORKER_ROLE=all
WORKER_METRICS_PORT=0
OUTBOX_BATCH_SIZE=10

# Usados ao habilitar o perfil local de autenticação.
KEYCLOAK_PORT=8080
OIDC_ISSUER=http://127.0.0.1:8080/realms/dwp
OIDC_AUDIENCE=dwp-api
